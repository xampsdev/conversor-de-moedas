<script>
    // Core application state
    let currentDirection = 'BRL_TO_USD'; // or 'USD_TO_BRL'
    let usdToBrlRate = 5.45; // Default reference rate
    let showingInvertedRate = false;
    let swapAngle = 0;

    const inputEl = document.getElementById('input-amount');
    const resultEl = document.getElementById('display-result');
    const rateLiveText = document.getElementById('status-live-text');
    const effectiveRateEl = document.getElementById('effective-rate');
    const noticeBanner = document.getElementById('notice-banner');
    const noticeText = document.getElementById('notice-text');
    const noticeIcon = document.getElementById('notice-icon');
    const swapIcon = document.getElementById('swap-icon');
    const refreshIcon = document.getElementById('refresh-icon');

    // Currency metadata configuration
    const currencies = {
      BRL: {
        code: 'BRL',
        symbol: 'R$',
        flag: '🇧🇷',
        name: 'Real brasileiro'
      },
      USD: {
        code: 'USD',
        symbol: '$',
        flag: '🇺🇸',
        name: 'Dólar comercial'
      }
    };

    // Helper: parse human formatted pt-BR number (e.g. 1.000,50 -> 1000.50)
    function parsePtBrNumber(valStr) {
      if (!valStr) return 0;
      const clean = valStr.toString().replace(/\./g, '').replace(',', '.').replace(/[^0-9.]/g, '');
      const num = parseFloat(clean);
      return isNaN(num) ? 0 : num;
    }

    // Helper: format standard float to pt-BR string with 2 decimals
    function formatPtBr(num) {
      return Number(num).toLocaleString('pt-BR', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    // Recalculate and update the converted display with micro-animation
    function calculate() {
      const rawVal = parsePtBrNumber(inputEl.value);

      if (rawVal <= 0) {
        resultEl.textContent = '0,00';
        return;
      }

      let calculated = 0;
      if (currentDirection === 'BRL_TO_USD') {
        calculated = rawVal / usdToBrlRate;
      } else {
        calculated = rawVal * usdToBrlRate;
      }

      // Smooth pulse glow on change
      resultEl.classList.remove('result-updated');
      void resultEl.offsetWidth; // Trigger reflow for CSS animation
      resultEl.classList.add('result-updated');

      resultEl.textContent = formatPtBr(calculated);
    }

    // Interactive Quick-Swap: rotate, flip pills, update logic
    function swapCurrencies() {
      swapAngle += 180;
      swapIcon.style.transform = `rotate(${swapAngle}deg)`;

      // Animate currency pill containers
      const pillSend = document.getElementById('pill-send');
      const pillReceive = document.getElementById('pill-receive');
      pillSend.classList.add('currency-pill-flip');
      pillReceive.classList.add('currency-pill-flip');

      setTimeout(() => {
        pillSend.classList.remove('currency-pill-flip');
        pillReceive.classList.remove('currency-pill-flip');
      }, 400);

      if (currentDirection === 'BRL_TO_USD') {
        currentDirection = 'USD_TO_BRL';
        updateUIForDirection('USD', 'BRL');
      } else {
        currentDirection = 'BRL_TO_USD';
        updateUIForDirection('BRL', 'USD');
      }

      calculate();
    }

    function updateUIForDirection(fromKey, toKey) {
      const from = currencies[fromKey];
      const to = currencies[toKey];

      // Source block elements
      document.getElementById('code-send').textContent = from.code;
      document.getElementById('name-send').textContent = from.name;
      document.getElementById('flag-send').textContent = from.flag;
      document.getElementById('symbol-send').textContent = from.symbol;

      // Dest block elements
      document.getElementById('code-receive').textContent = to.code;
      document.getElementById('name-receive').textContent = to.name;
      document.getElementById('flag-receive').textContent = to.flag;
      document.getElementById('symbol-receive').textContent = to.symbol;

      updateRateDisplays();
    }

    function updateRateDisplays() {
      if (showingInvertedRate) {
        const inv = (1 / usdToBrlRate).toFixed(4).replace('.', ',');
        rateLiveText.textContent = `1 BRL = ${inv} USD • Comercial ao vivo`;
        effectiveRateEl.textContent = `1 BRL = ${inv} USD`;
      } else {
        const dir = usdToBrlRate.toFixed(2).replace('.', ',');
        rateLiveText.textContent = `1 USD = ${dir} BRL • Comercial ao vivo`;
        effectiveRateEl.textContent = `1 USD = ${dir} BRL`;
      }
    }

    function reverseRateDisplay() {
      showingInvertedRate = !showingInvertedRate;
      const revIcon = document.getElementById('reverse-icon');
      revIcon.classList.toggle('rotate-180');
      updateRateDisplays();
      document.getElementById('btn-reverse-label').textContent = showingInvertedRate ? 'Ver taxa padrão' : 'Inverter taxa';
    }

    // Preset chips logic with bounce
    function addValue(amount) {
      const current = parsePtBrNumber(inputEl.value);
      const updated = current + amount;
      inputEl.value = formatPtBr(updated);
      calculate();
    }

    function clearValue() {
      inputEl.value = '0,00';
      calculate();
      inputEl.focus();
    }

    function addTravelEstimate() {
      if (currentDirection !== 'USD_TO_BRL') {
        swapCurrencies();
      }
      inputEl.value = '500,00';
      calculate();
      showNotice('Simulação rápida aplicada: $ 500 dólares para sua viagem!', 'flight_takeoff');
    }

    // Copy result action with interactive animated feedback & tooltip
    function copyResult() {
      const symbol = document.getElementById('symbol-receive').textContent;
      const value = resultEl.textContent.trim();
      const fullText = `${symbol} ${value}`;

      navigator.clipboard.writeText(fullText).then(() => {
        const copyBtn = document.getElementById('btn-copy');
        const copyTextEl = document.getElementById('copy-text');
        const copyIconEl = document.getElementById('copy-icon');
        const copyTooltip = document.getElementById('copy-tooltip');

        // Style button to positive feedback in dark mode
        copyBtn.classList.add('bg-emerald-950/80', 'text-emerald-400', 'border-emerald-500/40');
        copyTextEl.textContent = 'Copiado!';
        copyIconEl.textContent = 'check_circle';
        copyTooltip.classList.remove('opacity-0', 'scale-90');
        copyTooltip.classList.add('opacity-100', 'scale-100');

        setTimeout(() => {
          copyBtn.classList.remove('bg-emerald-950/80', 'text-emerald-400', 'border-emerald-500/40');
          copyTextEl.textContent = 'Copiar';
          copyIconEl.textContent = 'content_copy';
          copyTooltip.classList.remove('opacity-100', 'scale-100');
          copyTooltip.classList.add('opacity-0', 'scale-90');
        }, 2200);
      }).catch(() => {
        showNotice('Não foi possível copiar automaticamente.', 'warning');
      });
    }

    // Banner feedback helper
    function showNotice(msg, icon = 'info') {
      noticeText.textContent = msg;
      noticeIcon.textContent = icon;
      noticeBanner.classList.remove('hidden');
      noticeBanner.classList.add('flex', 'animate-fadeInUp');
    }

    function closeNotice() {
      noticeBanner.classList.add('hidden');
      noticeBanner.classList.remove('flex', 'animate-fadeInUp');
    }

    // Real-time API Fetch with graceful fallback and spinner animation
    async function refreshRate(isManual = false) {
      if (isManual) {
        refreshIcon.classList.add('animate-spin');
        rateLiveText.textContent = 'Buscando cotação no Banco Central...';
      }

      try {
        const response = await fetch('https://economia.awesomeapi.com.br/last/USD-BRL');
        if (response.ok) {
          const data = await response.json();
          if (data && data.USDBRL && data.USDBRL.bid) {
            usdToBrlRate = parseFloat(data.USDBRL.bid);
            updateRateDisplays();
            calculate();
            if (isManual) {
              showNotice(`Cotação atualizada em tempo real: R$ ${formatPtBr(usdToBrlRate)} por dólar.`, 'done_all');
            }
          }
        }
      } catch (e) {
        updateRateDisplays();
        if (isManual) {
          showNotice('Usando última cotação segura salva: 1 USD = 5,45 BRL.', 'offline_pin');
        }
      } finally {
        if (isManual) {
          setTimeout(() => {
            refreshIcon.classList.remove('animate-spin');
          }, 600);
        }
      }
    }

    // Live input events & formatting
    inputEl.addEventListener('input', () => {
      calculate();
    });

    inputEl.addEventListener('blur', () => {
      const val = parsePtBrNumber(inputEl.value);
      inputEl.value = formatPtBr(val);
      calculate();
    });

    // Preview interactive state showcase buttons
    document.getElementById('btn-state-normal').addEventListener('click', function() {
      resetStatePills();
      this.classList.add('bg-slate-800', 'text-blue-400', 'shadow-sm', 'border-blue-500/20', 'font-semibold');
      closeNotice();
      rateLiveText.textContent = '1 USD = 5,45 BRL • Comercial ao vivo';
      calculate();
    });

    document.getElementById('btn-state-loading').addEventListener('click', function() {
      resetStatePills();
      this.classList.add('bg-slate-800', 'text-blue-400', 'shadow-sm', 'border-blue-500/20', 'font-semibold');
      rateLiveText.textContent = 'Sincronizando taxas oficiais com Banco Central...';
      resultEl.textContent = '...';
      showNotice('Sincronizando taxas em milissegundos via API oficial do Banco Central.', 'sync');
    });

    document.getElementById('btn-state-alert').addEventListener('click', function() {
      resetStatePills();
      this.classList.add('bg-slate-800', 'text-blue-400', 'shadow-sm', 'border-blue-500/20', 'font-semibold');
      showNotice('Dica amigável: Para compras internacionais com cartão, lembre-se de conferir o IOF de 1,1%.', 'lightbulb');
    });

    function resetStatePills() {
      ['btn-state-normal', 'btn-state-loading', 'btn-state-alert'].forEach(id => {
        const btn = document.getElementById(id);
        btn.className = 'px-space-sm py-1 rounded-full font-label-sm text-label-sm transition-all duration-200 text-slate-400 hover:text-white hover:bg-slate-800/60 active:scale-95';
      });
    }

    // Header Navigation Tab Switcher with sliding indicator
    const navTabs = document.querySelectorAll('.nav-tab');
    const tabSlider = document.getElementById('tab-slider');

    navTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        navTabs.forEach(t => {
          t.setAttribute('aria-selected', 'false');
          t.classList.remove('font-semibold', 'text-white');
          t.classList.add('text-slate-400');
        });
        tab.setAttribute('aria-selected', 'true');
        tab.classList.remove('text-slate-400');
        tab.classList.add('font-semibold', 'text-white');

        // Translate indicator slider
        if (index === 0) {
          tabSlider.style.transform = 'translateX(0px)';
          tabSlider.style.width = '88px';
        } else {
          tabSlider.style.transform = 'translateX(88px)';
          tabSlider.style.width = '80px';
        }
      });
    });

    // Initial setup
    refreshRate();
    calculate();
  </script>




</body></html>
