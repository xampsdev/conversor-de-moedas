    /* Custom Animations & Keyframes */
    @keyframes fadeInUp {
      0% { opacity: 0; transform: translateY(18px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes floatPulseDark {
      0%, 100% { transform: translateY(0px) scale(1); box-shadow: 0 0 25px rgba(59, 130, 246, 0.45); }
      50% { transform: translateY(-3px) scale(1.04); box-shadow: 0 0 35px rgba(59, 130, 246, 0.65); }
